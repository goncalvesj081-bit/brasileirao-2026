rules_version = '2';
// Regras do bolão. Publicadas sozinhas pela atualização automática (scripts/bolao.ts).
// - jogos: horário de início de cada jogo, escrito só pelo script; trava os palpites.
// - palpites: cada um mexe só nos seus, e só até o jogo começar; ninguém lê os dos outros
//   (os palpites aparecem para todos depois que o jogo começa, em "publico", escritos pelo script).
// - usuarios: nome e foto para o ranking; cada um edita só o seu.
// - perfis: nome completo, nascimento e WhatsApp, para falar com quem ganhar; só o dono lê e
//   edita (e quem administra o projeto, pelo console do Firebase). Sem cadastro, não há palpite.
// - publico: ranking e palpites revelados, escritos só pelo script.
// - estatisticas: contagem anônima de visitas por dia; só quem administra lê.
service cloud.firestore {
  match /databases/{database}/documents {
    match /jogos/{jogo} {
      allow read: if true;
      allow write: if false;
    }

    function placarValido(d) {
      return d.gm is int && d.gv is int && d.gm >= 0 && d.gv >= 0 && d.gm <= 20 && d.gv <= 20;
    }
    function antesDoJogo(jogo) {
      let j = get(/databases/$(database)/documents/jogos/$(jogo));
      return j != null && j.data.inicio != null && request.time < j.data.inicio;
    }

    match /palpites/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.jogo
        && request.resource.data.keys().hasOnly(["uid", "jogo", "gm", "gv", "rodada", "em"])
        && request.resource.data.rodada is int
        && request.resource.data.em == request.time
        && placarValido(request.resource.data)
        && antesDoJogo(request.resource.data.jogo)
        && exists(/databases/$(database)/documents/perfis/$(request.auth.uid));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid && antesDoJogo(resource.data.jogo);
    }

    // foto: vazia ou do Google (um endereço qualquer seria buscado pelo navegador de quem abre o ranking)
    match /usuarios/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nome", "foto"])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 30
        && (!("foto" in request.resource.data) || request.resource.data.foto == ""
          || (request.resource.data.foto is string && request.resource.data.foto.size() <= 500
            && request.resource.data.foto.matches('^https://[a-z0-9.-]+[.]googleusercontent[.]com/.*$')));
    }

    match /perfis/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nome", "nascimento", "whatsapp", "aceite", "em"])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 60
        && request.resource.data.nascimento is string && request.resource.data.nascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^55[1-9][0-9]{9,10}$')
        && request.resource.data.aceite == true;
      allow delete: if false;
    }

    match /publico/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Contagem anônima de visitas (só números, um documento por dia). Quem visita só consegue somar
    // um pouco a cada escrita; só quem administra lê. A lista de admins é a mesma de config/admin.ts.
    function admin() {
      return request.auth != null && request.auth.uid in [];
    }
    function contadorOk(k, antes) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int && request.resource.data[k] >= antes.get(k, 0) && request.resource.data[k] <= antes.get(k, 0) + 1);
    }
    function telasOk(antes) {
      return !("telas" in request.resource.data)
        || (request.resource.data.telas is map && request.resource.data.telas.size() <= 12
          && request.resource.data.telas.keys().hasOnly(["tabela", "jogos", "chances", "simular", "numeros", "serie_b", "clube", "comparar", "sobre", "mais"]));
    }
    function visitaOk(antes) {
      return request.resource.data.keys().hasOnly(["visitantes", "novos", "acessos", "celular", "computador", "app", "telas"])
        && contadorOk("visitantes", antes) && contadorOk("novos", antes) && contadorOk("acessos", antes)
        && contadorOk("celular", antes) && contadorOk("computador", antes) && contadorOk("app", antes)
        && telasOk(antes);
    }
    match /estatisticas/{dia} {
      allow read: if admin();
      allow create: if dia.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && visitaOk({});
      allow update: if visitaOk(resource.data);
      allow delete: if false;
    }
  }
}
